<Window x:Class="PersonalExpenseTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PersonalExpenseTracker.Converters"
        xmlns:helpers="clr-namespace:PersonalExpenseTracker.Helpers"
        Title="Personal Expense Tracker" Height="840" Width="1320" MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
  <Window.Resources>
    <conv:CategoryBrushConverter x:Key="CategoryBrush"/>

    <DataTemplate x:Key="CategoryItemTemplate">
      <StackPanel Orientation="Horizontal">
        <Ellipse Width="10" Height="10" Fill="{Binding AccentBrush}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="CategorySummaryTemplate">
      <StackPanel Margin="0,0,0,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Ellipse Width="9" Height="9" Fill="{Binding AccentBrush}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="9,0,0,0" FontWeight="SemiBold"/>
          <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontWeight="SemiBold"/>
        </Grid>
        <ProgressBar Style="{StaticResource CategoryProgressBar}" Value="{Binding Percent, Mode=OneWay}"
                     Foreground="{Binding AccentBrush}" Margin="0,8,0,5"/>
        <TextBlock Text="{Binding DetailText}" Style="{StaticResource MutedText}" FontSize="11"/>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ===================== Header ===================== -->
    <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="32,20">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Border Width="50" Height="50" CornerRadius="13" Background="#33FFFFFF">
            <TextBlock Text="Ft" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Personal Expense Tracker" FontSize="23" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="HeaderSubtitleTextBlock" FontSize="12" Foreground="#B4C3D6" Margin="0,3,0,0"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="LoadSampleButton" Style="{StaticResource GhostButton}" Click="LoadSampleButton_Click" ToolTip="Add example expenses for a quick demo">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
              <TextBlock Text="Load sample data" Margin="8,0,0,0"/>
            </StackPanel>
          </Button>
          <Button x:Name="ClearAllButton" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="ClearAllButton_Click" ToolTip="Remove every expense">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
              <TextBlock Text="Clear all" Margin="8,0,0,0"/>
            </StackPanel>
          </Button>
          <Button x:Name="ThemeToggleButton" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="ThemeToggleButton_Click" ToolTip="Switch between light and dark mode">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="ThemeIconTextBlock" Text="&#xE708;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
              <TextBlock x:Name="ThemeTextTextBlock" Text="Dark mode" Margin="8,0,0,0"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===================== Body ===================== -->
    <Grid Grid.Row="1" Margin="28,24,28,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="370"/>
        <ColumnDefinition Width="24"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left column: compact form + breakdown that fills the remaining height -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,18">
          <StackPanel>
            <TextBlock Text="New expense" Style="{StaticResource CardTitle}"/>

            <TextBlock Text="Description" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
            <TextBox x:Name="DescriptionTextBox" MaxLength="100" Padding="12,8" helpers:TextBoxHelper.Placeholder="e.g. Groceries, bus ticket"/>
            <TextBlock x:Name="DescriptionErrorTextBlock" Style="{StaticResource ErrorText}"/>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="Amount" Style="{StaticResource FieldLabel}"/>
              <TextBlock Grid.Row="0" Grid.Column="2" Text="Date" Style="{StaticResource FieldLabel}"/>

              <Grid Grid.Row="1" Grid.Column="0">
                <TextBox x:Name="AmountTextBox" Padding="12,8,46,8" helpers:TextBoxHelper.Placeholder="0.00"/>
                <TextBlock Text="HUF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" FontSize="12"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False"/>
              </Grid>
              <DatePicker Grid.Row="1" Grid.Column="2" x:Name="ExpenseDatePicker"/>

              <TextBlock Grid.Row="2" Grid.Column="0" x:Name="AmountErrorTextBlock" Style="{StaticResource ErrorText}"/>
              <TextBlock Grid.Row="2" Grid.Column="2" x:Name="DateErrorTextBlock" Style="{StaticResource ErrorText}"/>
            </Grid>

            <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="CategoryComboBox" ItemTemplate="{StaticResource CategoryItemTemplate}" Padding="12,8,34,8"/>
              <Button Grid.Column="2" x:Name="AddCategoryButton" Content="&#xE710;" Style="{StaticResource SecondaryButton}"
                      FontFamily="{StaticResource IconFont}" FontSize="14" Width="40" Padding="0"
                      ToolTip="Add a new category" Click="AddCategoryButton_Click"/>
            </Grid>
            <TextBlock x:Name="CategoryErrorTextBlock" Style="{StaticResource ErrorText}"/>

            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="AddExpenseButton" Style="{StaticResource PrimaryButton}" Padding="18,11" Click="AddExpenseButton_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                  <TextBlock Text="Add expense" Margin="9,0,0,0"/>
                </StackPanel>
              </Button>
              <Button Grid.Column="2" Content="Clear" Style="{StaticResource SecondaryButton}" Padding="18,11" Click="ClearFormButton_Click"/>
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,18,8,8" Margin="0,16,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Spending by category" Style="{StaticResource CardTitle}" Margin="0,0,12,14"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
              <StackPanel>
                <ItemsControl x:Name="CategorySummaryItemsControl" ItemTemplate="{StaticResource CategorySummaryTemplate}"/>
                <TextBlock x:Name="CategorySummaryEmptyTextBlock" Text="No spending recorded yet." Style="{StaticResource MutedText}"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
      <!-- Right column: stats, filters, table -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Stat cards -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,18">
            <StackPanel>
              <Border Width="28" Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
              <TextBlock Text="TOTAL SPENDING" Style="{StaticResource CaptionText}"/>
              <TextBlock x:Name="OverallTotalTextBlock" Text="0.00 HUF" FontSize="24" FontWeight="Bold" Margin="0,6,0,0"/>
              <TextBlock x:Name="ExpenseCountTextBlock" Text="0 expenses" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18">
            <StackPanel>
              <Border Width="28" Height="4" CornerRadius="2" Background="#0F766E" HorizontalAlignment="Left" Margin="0,0,0,12"/>
              <TextBlock Text="VISIBLE SPENDING" Style="{StaticResource CaptionText}"/>
              <TextBlock x:Name="FilteredTotalTextBlock" Text="0.00 HUF" FontSize="24" FontWeight="Bold" Margin="0,6,0,0"/>
              <TextBlock x:Name="FilteredCountTextBlock" Text="0 visible" Style="{StaticResource MutedText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>

          <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20,18">
            <StackPanel>
              <Border Width="28" Height="4" CornerRadius="2" Background="#B7791F" HorizontalAlignment="Left" Margin="0,0,0,12"/>
              <TextBlock Text="TOP CATEGORY" Style="{StaticResource CaptionText}"/>
              <TextBlock x:Name="TopCategoryTextBlock" Text="—" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="TopCategoryAmountTextBlock" Text="No data yet" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
            </StackPanel>
          </Border>

          <Border Grid.Column="6" Style="{StaticResource Card}" Padding="20,18">
            <StackPanel>
              <Border Width="28" Height="4" CornerRadius="2" Background="#64748B" HorizontalAlignment="Left" Margin="0,0,0,12"/>
              <TextBlock Text="AVERAGE EXPENSE" Style="{StaticResource CaptionText}"/>
              <TextBlock x:Name="AverageTextBlock" Text="0.00 HUF" FontSize="24" FontWeight="Bold" Margin="0,6,0,0"/>
              <TextBlock Text="per expense" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Filter toolbar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="240"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
              <TextBox x:Name="SearchTextBox" Padding="40,10,12,10" helpers:TextBoxHelper.Placeholder="Search descriptions…"/>
              <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="14,0,0,0"
                         VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False"/>
            </Grid>
            <ComboBox x:Name="FilterCategoryComboBox" Grid.Column="2" ItemTemplate="{StaticResource CategoryItemTemplate}"/>
            <Button Grid.Column="4" Content="Clear filters" Style="{StaticResource SecondaryButton}" Padding="18,10" Click="ClearFilterButton_Click"/>
          </Grid>
        </Border>

        <!-- Expense table -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8,4,8,8">
          <Grid>
            <DataGrid x:Name="ExpensesDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      CanUserDeleteRows="False" CanUserResizeColumns="False" CanUserReorderColumns="False"
                      SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="None"
                      Background="Transparent" BorderThickness="0" RowHeaderWidth="0" RowHeight="52" AlternationCount="2"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      SelectionChanged="ExpensesDataGrid_SelectionChanged" KeyDown="ExpensesDataGrid_KeyDown">
              <DataGrid.Columns>
                <DataGridTextColumn Header="DATE" Width="130" Binding="{Binding Date, StringFormat={}{0:dd MMM yyyy}}" SortMemberPath="Date">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="DESCRIPTION" Width="*" Binding="{Binding Description}">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="FontWeight" Value="SemiBold"/>
                      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="CATEGORY" Width="180" SortMemberPath="Category">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border HorizontalAlignment="Left" CornerRadius="12" Padding="11,4"
                              Background="{Binding Category, Converter={StaticResource CategoryBrush}, ConverterParameter=tint}">
                        <StackPanel Orientation="Horizontal">
                          <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                   Fill="{Binding Category, Converter={StaticResource CategoryBrush}}"/>
                          <TextBlock Text="{Binding Category}" Margin="7,0,0,0" FontSize="12" FontWeight="SemiBold"
                                     Foreground="{Binding Category, Converter={StaticResource CategoryBrush}}"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="AMOUNT (HUF)" Width="160" Binding="{Binding Amount, StringFormat={}{0:N2}}" SortMemberPath="Amount">
                  <DataGridTextColumn.HeaderStyle>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                      <Setter Property="HorizontalContentAlignment" Value="Right"/>
                    </Style>
                  </DataGridTextColumn.HeaderStyle>
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="HorizontalAlignment" Value="Right"/>
                      <Setter Property="FontWeight" Value="Bold"/>
                      <Setter Property="FontSize" Value="14"/>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="" Width="64" CanUserSort="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="&#xE74D;" Style="{StaticResource IconButton}" HorizontalAlignment="Center"
                              ToolTip="Delete this expense" Click="RowDeleteButton_Click"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>

            <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed">
              <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="EmptyStateTitleTextBlock" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
              <TextBlock x:Name="EmptyStateMessageTextBlock" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Action bar -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="SelectionHintTextBlock" Text="Select an expense to delete it." VerticalAlignment="Center"
                     Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
          <Button x:Name="DeleteSelectedButton" Grid.Column="1" Style="{StaticResource DangerButton}" IsEnabled="False"
                  Click="DeleteSelectedButton_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
              <TextBlock Text="Delete selected" Margin="9,0,0,0"/>
            </StackPanel>
          </Button>
        </Grid>
      </Grid>
    </Grid>

    <!-- ===================== Toast ===================== -->
    <Border x:Name="ToastBorder" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,36,28" Padding="18,13" CornerRadius="12" BorderThickness="1" MaxWidth="460" Visibility="Collapsed"
            IsHitTestVisible="False">
      <Border.Effect>
        <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.25" Color="#000000"/>
      </Border.Effect>
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="ToastIconTextBlock" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center"/>
        <TextBlock x:Name="ToastTextBlock" Margin="12,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
