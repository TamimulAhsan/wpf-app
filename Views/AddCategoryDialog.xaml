<Window x:Class="PersonalExpenseTracker.Views.AddCategoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:PersonalExpenseTracker.Helpers"
        Title="New category" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Foreground="{DynamicResource TextBrush}" Loaded="Window_Loaded">
  <Grid>
    <Border Margin="24" Width="430" CornerRadius="16" Background="{DynamicResource SurfaceBrush}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.35" Color="#000000"/>
      </Border.Effect>
    </Border>
    <Border Margin="24" Width="430" CornerRadius="16" Padding="28,26,28,24"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
      <StackPanel>
        <TextBlock Text="New category" FontSize="18" FontWeight="Bold"/>
        <TextBlock Text="Name your category and pick a colour." Style="{StaticResource MutedText}" Margin="0,4,0,0"/>

        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,20,0,6"/>
        <TextBox x:Name="NameTextBox" MaxLength="24" helpers:TextBoxHelper.Placeholder="e.g. Subscriptions"
                 TextChanged="NameTextBox_TextChanged"/>
        <TextBlock x:Name="NameErrorTextBlock" Style="{StaticResource ErrorText}"/>

        <TextBlock Text="Colour" Style="{StaticResource FieldLabel}"/>
        <WrapPanel x:Name="SwatchPanel"/>

        <TextBlock Text="Preview" Style="{StaticResource FieldLabel}" Margin="0,6,0,8"/>
        <Border x:Name="PreviewBorder" HorizontalAlignment="Left" CornerRadius="12" Padding="11,4">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="PreviewDot" Width="7" Height="7" VerticalAlignment="Center"/>
            <TextBlock x:Name="PreviewTextBlock" Margin="7,0,0,0" FontSize="12" FontWeight="SemiBold"/>
          </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
          <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}" MinWidth="96"/>
          <Button Content="Add category" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" MinWidth="120"
                  Click="AddButton_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
