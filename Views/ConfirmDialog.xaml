<Window x:Class="PersonalExpenseTracker.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Foreground="{DynamicResource TextBrush}" Loaded="Window_Loaded">
  <Grid>
    <Border Margin="24" Width="430" CornerRadius="16" Background="{DynamicResource SurfaceBrush}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.35" Color="#000000"/>
      </Border.Effect>
    </Border>
    <Border Margin="24" Width="430" CornerRadius="16" Padding="28,26,28,24"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Border x:Name="IconBadge" Width="46" Height="46" CornerRadius="23" VerticalAlignment="Top">
            <TextBlock x:Name="IconGlyph" FontFamily="{StaticResource IconFont}" FontSize="19"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="16,0,0,0" Width="300">
            <TextBlock x:Name="TitleTextBlock" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="MessageTextBlock" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
          <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}" MinWidth="96"/>
          <Button x:Name="ConfirmButton" Margin="10,0,0,0" MinWidth="110" Click="ConfirmButton_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
